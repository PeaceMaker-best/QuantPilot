# SignalFoundry strict production configuration template
# ===================================================
# Copy this file OUTSIDE the repository, replace every placeholder, then run:
#   npm run check:production -- --env-file /secure/path/signalfoundry.env
# Inject the same public/build values at build time and all values at runtime.
# Prefer an orchestrator secret manager over a long-lived file.
#
# The template chooses the recommended topology: Qwen and daily DeepSeek through
# AetherGateway, Memory enabled through a short-lived token broker. Alternative direct
# DeepSeek and Memory-disabled settings are documented inline and in
# docs/configuration.md. Do not commit the populated file.

# Runtime and canonical public origin
NODE_ENV=production
SIGNALFOUNDRY_DEGRADATION_MODE=strict
NEXT_PUBLIC_APP_URL=https://signalfoundry.example.com
BETTER_AUTH_URL=https://signalfoundry.example.com
SIGNALFOUNDRY_WEB_HOST=0.0.0.0
PORT=3000

# Authentication and browser security
SIGNALFOUNDRY_AUTH_SECRET=replace-with-32-plus-random-characters
SIGNALFOUNDRY_AUTH_MODE=local
SIGNALFOUNDRY_AUTH_SECURE_COOKIES=1
SIGNALFOUNDRY_SECURITY_HSTS=1
SIGNALFOUNDRY_AUTH_TRUSTED_ORIGINS=https://signalfoundry.example.com
SIGNALFOUNDRY_AUTH_ALLOW_SIGNUP=0
SIGNALFOUNDRY_AUTH_REMEMBER_ME=0
SIGNALFOUNDRY_AUTH_AUDIT_RETENTION_DAYS=180
SIGNALFOUNDRY_AUTH_EXPIRED_RECORD_GRACE_SECONDS=3600

# Use --require-bootstrap only for the one-time administrator bootstrap. Remove
# both values from the long-running service environment after bootstrap.
SIGNALFOUNDRY_AUTH_ADMIN_EMAIL=admin@example.com
SIGNALFOUNDRY_AUTH_ADMIN_PASSWORD=replace-with-strong-bootstrap-password
SIGNALFOUNDRY_AUTH_ADMIN_NAME=SignalFoundry 管理员

# Durable stores. PROJECTS_DIR must be shared by every pod allowed to execute the
# same project/namespace, and must survive application restarts.
DATABASE_URL=postgresql://signalfoundry:replace-with-database-password@timescaledb:5432/signalfoundry?schema=public
REDIS_URL=redis://redis:6379/0
PROJECTS_DIR=/var/lib/signalfoundry/projects
# Shared durable volume, outside immutable application releases; include in backups.
SIGNALFOUNDRY_SKILLS_STATE_DIR=/var/lib/signalfoundry/skill-catalog
ENCRYPTION_KEY=replace-with-64-hex-characters

# Required service topology
SIGNALFOUNDRY_DATABASE_ENABLED=1
SIGNALFOUNDRY_DATABASE_REQUIRED=1
SIGNALFOUNDRY_MARKET_API_ENABLED=1
SIGNALFOUNDRY_MARKET_API_REQUIRED=1
SIGNALFOUNDRY_MARKET_API_URL=http://market-data:8000
SIGNALFOUNDRY_MARKET_ADMIN_TOKEN=replace-with-32-plus-random-characters
SIGNALFOUNDRY_MARKET_MAINTENANCE_ENABLED=1
SIGNALFOUNDRY_MARKET_MAINTENANCE_UNIVERSE_ID=a-share-sample-research-pool
SIGNALFOUNDRY_MARKET_CALENDAR_LOOKBACK_DAYS=30
SIGNALFOUNDRY_MARKET_HISTORY_LOOKBACK_DAYS=14
SIGNALFOUNDRY_MARKET_MAINTENANCE_REQUEST_DELAY_SECONDS=0.2
SIGNALFOUNDRY_MARKET_MAINTENANCE_BATCH_DELAY_SECONDS=0.7
SIGNALFOUNDRY_MARKET_MAINTENANCE_BATCH_SIZE=25
SIGNALFOUNDRY_MARKET_MAINTENANCE_MAX_RETRIES=3
SIGNALFOUNDRY_MARKET_MAINTENANCE_POLL_INTERVAL_MS=2000
SIGNALFOUNDRY_MARKET_CALENDAR_TIMEOUT_MS=120000
SIGNALFOUNDRY_MARKET_INGESTION_TIMEOUT_MS=1800000
SIGNALFOUNDRY_MARKET_FRESHNESS_MIN_SYMBOLS=250
SIGNALFOUNDRY_REDIS_CACHE_ENABLED=1
SIGNALFOUNDRY_REDIS_REQUIRED=1
SIGNALFOUNDRY_OBSERVABILITY_ENABLED=1
SIGNALFOUNDRY_OBSERVABILITY_REQUIRED=1
SIGNALFOUNDRY_CLICKHOUSE_ENABLED=0
SIGNALFOUNDRY_CLICKHOUSE_REQUIRED=0

# Observability endpoints. Keep anonymous Grafana access disabled in production.
LOKI_URL=http://loki:3100
GRAFANA_ANONYMOUS_ENABLED=0
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

# Model access — recommended topology
# AETHERGATEWAY_API_KEY is a scoped AetherGateway client key. DeepSeek/Qwen upstream keys
# remain in AetherGateway and must never be copied into SignalFoundry.
AETHERGATEWAY_API_KEY=replace-with-production-aethergateway-client-key
SIGNALFOUNDRY_AETHERGATEWAY_URL=https://aethergateway.internal.example
SIGNALFOUNDRY_AETHERGATEWAY_ENABLED=1
SIGNALFOUNDRY_AETHERGATEWAY_REQUIRED=1
SIGNALFOUNDRY_AETHERGATEWAY_ORGANIZATION_ID=org_signalfoundry
SIGNALFOUNDRY_AETHERGATEWAY_PROJECT_ID=prj_signalfoundry
SIGNALFOUNDRY_AETHERGATEWAY_ENVIRONMENT_ID=env_production

SIGNALFOUNDRY_KNOWLEDGE_ENABLED=1
SIGNALFOUNDRY_KNOWLEDGE_REQUIRED=1
SIGNALFOUNDRY_KNOWLEDGE_API_URL=https://knowledge.internal.example
SIGNALFOUNDRY_KNOWLEDGE_PURPOSE=quant-research
SIGNALFOUNDRY_KNOWLEDGE_SPACES=https://knowledge.internal.example/spaces/quant-research
SIGNALFOUNDRY_KNOWLEDGE_PROJECT_SPACES_ENABLED=1
SIGNALFOUNDRY_KNOWLEDGE_PROJECT_SPACE_BASE_URL=https://knowledge.internal.example/spaces/signalfoundry/projects
SIGNALFOUNDRY_KNOWLEDGE_TIMEOUT_MS=2000
SIGNALFOUNDRY_KNOWLEDGE_MAX_CONTEXT_CHARACTERS=8000
SIGNALFOUNDRY_KNOWLEDGE_BEARER_TOKEN=
SIGNALFOUNDRY_KNOWLEDGE_OAUTH_TOKEN_URL=https://identity.internal.example/oauth2/token
SIGNALFOUNDRY_KNOWLEDGE_OAUTH_CLIENT_ID=signalfoundry
SIGNALFOUNDRY_KNOWLEDGE_OAUTH_CLIENT_SECRET=inject-from-secret-manager
SIGNALFOUNDRY_KNOWLEDGE_OAUTH_RESOURCE=https://knowledge.internal.example/akep/0.1
SIGNALFOUNDRY_KNOWLEDGE_OAUTH_SCOPE="akep:query akep:read akep:feedback"
SIGNALFOUNDRY_LLM_AGENT_ENABLED=1
SIGNALFOUNDRY_LLM_QUERY_REWRITE_ENABLED=1
SIGNALFOUNDRY_QUERY_REWRITE_LLM_TIMEOUT_MS=12000
SIGNALFOUNDRY_QUERY_REWRITE_LLM_MAX_RETRIES=0

# Optional official-direct DeepSeek profile. Inject this variable only when projects
# explicitly select `deepseek-v4-flash`. It does not change the Qwen global default.
# DEEPSEEK_API_KEY=inject-with-your-secret-manager

# Evolvable User Memory — production-enabled example
# ENABLED=0 is a supported normal deployment and then every remaining MEMORY_* value
# may be omitted. REQUIRED=0 only permits degradation; it does not disable Memory.
SIGNALFOUNDRY_MEMORY_ENABLED=1
SIGNALFOUNDRY_MEMORY_REQUIRED=1
SIGNALFOUNDRY_MEMORY_REQUIRE_PRODUCTION_READY=1
SIGNALFOUNDRY_MEMORY_API_URL=https://memory.internal.example.com
SIGNALFOUNDRY_MEMORY_TENANT_ID=signalfoundry-production
SIGNALFOUNDRY_MEMORY_TIMEOUT_MS=1200
SIGNALFOUNDRY_MEMORY_RECALL_LIMIT=6
SIGNALFOUNDRY_MEMORY_MAX_CONTEXT_CHARACTERS=2000
# Static SIGNALFOUNDRY_MEMORY_BEARER_TOKEN is forbidden for multi-user production.
SIGNALFOUNDRY_MEMORY_BEARER_TOKEN=
SIGNALFOUNDRY_MEMORY_TOKEN_BROKER_URL=https://identity.internal.example.com/memory-token
SIGNALFOUNDRY_MEMORY_TOKEN_BROKER_CLIENT_ID=signalfoundry-production
SIGNALFOUNDRY_MEMORY_TOKEN_BROKER_CLIENT_SECRET=replace-with-token-broker-client-secret
SIGNALFOUNDRY_MEMORY_TOKEN_AUDIENCE=evolvable-memory-api
SIGNALFOUNDRY_MEMORY_PRODUCTION_PROBE_SUBJECT_ID=svc_signalfoundry_readiness

# Host-level administration. The internal token API remains off unless a separately
# authenticated trusted control plane explicitly requires it.
SIGNALFOUNDRY_ADMIN_TOKEN=replace-with-32-plus-random-characters
SIGNALFOUNDRY_ENABLE_INTERNAL_TOKEN_API=0
SIGNALFOUNDRY_INTERNAL_API_TOKEN=

# Generated workspace isolation and distributed execution identity
SIGNALFOUNDRY_GENERATED_SANDBOX=1
SIGNALFOUNDRY_ALLOW_UNSANDBOXED_GENERATED_CODE=0
PI_AGENT_WORKSPACE_NAMESPACE=signalfoundry-production
PI_AGENT_INSTANCE_ID=
PI_AGENT_TIMEOUT_MS=1200000
PI_AGENT_LEASE_TTL_MS=60000
PI_AGENT_HEARTBEAT_INTERVAL_MS=15000
PI_AGENT_DISPATCH_MODE=worker
PI_AGENT_DISPATCH_LEASE_TTL_MS=120000
PI_AGENT_DISPATCH_HEARTBEAT_INTERVAL_MS=30000
PI_AGENT_DISPATCH_PENDING_ORPHAN_GRACE_MS=120000
PI_AGENT_DISPATCH_RETRY_BASE_DELAY_MS=5000
PI_AGENT_WORKER_POLL_INTERVAL_MS=1000
PI_AGENT_WORKER_CONCURRENCY=2
# Must be identical for every live Worker sharing this PostgreSQL/pool. Worker
# registration fails closed when a different live value already exists.
PI_AGENT_WORKER_GLOBAL_CONCURRENCY=4
PI_AGENT_WORKER_CLAIM_BATCH_SIZE=20
# These intervals protect both process registration and execution-slot leases.
PI_AGENT_WORKER_SLOT_LEASE_TTL_MS=120000
PI_AGENT_WORKER_SLOT_HEARTBEAT_INTERVAL_MS=30000
PI_AGENT_RESOURCE_LOCK_WAIT_MS=5000

# Release evaluation assurance. Paths must be mounted secrets, not repository files.
SIGNALFOUNDRY_REQUIRE_HIDDEN_EVAL=1
SIGNALFOUNDRY_REQUIRE_PRODUCTION_JUDGE_CALIBRATION=1
SIGNALFOUNDRY_REQUIRE_INDEPENDENT_JUDGE=1
SIGNALFOUNDRY_EVAL_DATASET_VISIBILITY=hidden
SIGNALFOUNDRY_REPLAY_HASH_KEY=replace-with-16-plus-random-characters
SIGNALFOUNDRY_HIDDEN_EVAL_CASES_PATH=/run/secrets/signalfoundry-hidden-eval-cases.json
SIGNALFOUNDRY_EVAL_JUDGE_CALIBRATION_PATH=/run/secrets/signalfoundry-judge-calibration.json
