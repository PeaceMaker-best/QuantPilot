[Unit]
Description=Refresh SignalFoundry trading calendar and daily market data
After=network-online.target signalfoundry-market-data.service
Wants=network-online.target
Requires=signalfoundry-market-data.service

[Service]
Type=oneshot
User=signalfoundry
Group=signalfoundry
WorkingDirectory=/opt/signalfoundry/current
EnvironmentFile=/etc/signalfoundry/signalfoundry.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run market:maintain
TimeoutStartSec=2h
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/signalfoundry /opt/signalfoundry/current/tmp
