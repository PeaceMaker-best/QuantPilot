[Unit]
Description=SignalFoundry durable Data Agent generation worker
After=network-online.target signalfoundry-market-data.service
Wants=network-online.target
Requires=signalfoundry-market-data.service

[Service]
Type=simple
User=signalfoundry
Group=signalfoundry
WorkingDirectory=/opt/signalfoundry/current
EnvironmentFile=/etc/signalfoundry/signalfoundry.env
Environment=NODE_ENV=production
Environment=PI_AGENT_DISPATCH_MODE=worker
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/env node scripts/checks/check-production-readiness.js
ExecStart=/usr/bin/env npm run worker:generation
Restart=on-failure
RestartSec=5s
TimeoutStopSec=180s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/signalfoundry /opt/signalfoundry/current/tmp /opt/signalfoundry/current/public/uploads
LimitNOFILE=65536
