[Unit]
Description=SignalFoundry market data API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signalfoundry
Group=signalfoundry
WorkingDirectory=/opt/signalfoundry/current
EnvironmentFile=/etc/signalfoundry/signalfoundry.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=UV_CACHE_DIR=/var/cache/signalfoundry/uv
ExecStart=/usr/bin/env uv run --frozen --extra baostock --extra akshare --project services/market-data signalfoundry-market-api
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/signalfoundry /var/cache/signalfoundry
LimitNOFILE=32768

[Install]
WantedBy=multi-user.target
