[Unit]
Description=SignalFoundry expired auth data and audit retention cleanup
After=network-online.target

[Service]
Type=oneshot
User=signalfoundry
Group=signalfoundry
WorkingDirectory=/opt/signalfoundry/current
EnvironmentFile=/etc/signalfoundry/signalfoundry.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run auth:cleanup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/signalfoundry /opt/signalfoundry/current/tmp
