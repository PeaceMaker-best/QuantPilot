[Unit]
Description=SignalFoundry standalone web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signalfoundry
Group=signalfoundry
WorkingDirectory=/opt/signalfoundry/current
EnvironmentFile=/etc/signalfoundry/signalfoundry.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStartPre=/usr/bin/env node scripts/checks/check-production-readiness.js
ExecStart=/usr/bin/env node .next/standalone/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/signalfoundry /opt/signalfoundry/current/tmp /opt/signalfoundry/current/public/uploads /opt/signalfoundry/current/.next/standalone/.next/cache
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
